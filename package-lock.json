{
  "name": "anime-week",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "anime-week",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.5.0"
      }
    },
    "node_modules/@anime-week/collector": {
      "resolved": "packages/collector",
      "link": true
    },
    "node_modules/@anime-week/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@anime-week/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/collector": {
      "name": "@anime-week/collector",
      "version": "1.0.0",
      "dependencies": {
        "@anime-week/core": "1.0.0"
      },
      "bin": {
        "anime-week": "src/cli.js"
      }
    },
    "packages/core": {
      "name": "@anime-week/core",
      "version": "1.0.0"
    },
    "packages/web": {
      "name": "@anime-week/web",
      "version": "1.0.0",
      "dependencies": {
        "@anime-week/collector": "1.0.0",
        "@anime-week/core": "1.0.0"
      }
    }
  }
}
