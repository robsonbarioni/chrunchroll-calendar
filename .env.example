# Fuso usado para agrupar os lançamentos por dia no calendário
TZ_DISPLAY=America/Sao_Paulo
# Locale pedido à API do Crunchyroll (títulos/descrições)
CR_LOCALE=pt-BR
# Caminho do banco SQLite
DB_PATH=./data/anime-week.db
# Porta da interface web
PORT=5173
# Intervalo do modo watch, em minutos
COLLECT_INTERVAL_MIN=30
