# Fuso usado para agrupar os lançamentos por dia no calendário
TZ_DISPLAY=America/Sao_Paulo
# Locale pedido à API do Crunchyroll (títulos/descrições)
CR_LOCALE=pt-BR
# Caminho do banco SQLite
DB_PATH=./data/anime-week.db
# Porta da interface web
PORT=5173

# --- coleta automática ---
# Intervalo entre verificações, em minutos
COLLECT_INTERVAL_MIN=15
# Atraso sobre a grade, em segundos: com 15 min e 120s, consulta :02 :17 :32 :47.
# Serve para dar tempo do episódio ser indexado depois do horário de estreia.
COLLECT_OFFSET_SEC=120
# Páginas de 100 itens buscadas em cada verificação automática
COLLECT_PAGES=2
# Defina 0 para o servidor web não coletar sozinho
AUTO_COLLECT=1
